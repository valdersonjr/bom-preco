# Copie para .env.local e preencha. .env.local não vai para o repositório.
#
# Ambas as variáveis são públicas por natureza — aparecem no navegador de
# qualquer usuário. O que protege o banco são as políticas de acesso e os
# privilégios, não o sigilo delas.
#
# A chave de serviço (service_role) NUNCA entra aqui: ela ignora toda a RLS.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
