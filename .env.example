# Dois arquivos, dois leitores. Ambos no gitignore.
#
#   .env.local  → lido pelo Vite, vira parte do pacote do navegador
#   .env        → lido pelo CLI do Supabase, resolve os env() do config.toml
#
# Nada aqui deve ter valor real: este arquivo é versionado.


# ---------------------------------------------------------------------------
# .env.local — copie estas duas e preencha
# ---------------------------------------------------------------------------
#
# São públicas por natureza: aparecem no navegador de qualquer usuário. O que
# protege o banco são as políticas de acesso e os privilégios, não o sigilo
# delas. Estão no painel do Supabase, em Project Settings → API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# .env — copie esta e preencha, quando for ligar o e-mail
# ---------------------------------------------------------------------------
#
# Essa é secreta de verdade. O config.toml a referencia como
# env(RESEND_API_KEY), então o CLI resolve na hora do push e ela nunca entra no
# repositório. Necessária para o vínculo de conta por e-mail (RF-38), porque o
# serviço embutido do Supabase estoura em poucos envios por hora.

RESEND_API_KEY=


# ---------------------------------------------------------------------------
# Nunca em arquivo nenhum
# ---------------------------------------------------------------------------
#
# A chave de serviço do Supabase (service_role) ignora toda a RLS. Scripts de
# manutenção a recebem direto do CLI para a variável de ambiente, sem passar
# por disco — o comando está no CLAUDE.md.
